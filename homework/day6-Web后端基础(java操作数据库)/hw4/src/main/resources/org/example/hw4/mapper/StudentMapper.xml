<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- namespace绑定Mapper接口全类名 -->
<mapper namespace="org.example.hw4.mapper.StudentMapper">
    <select id="selectById" resultType="org.example.hw4.pojo.Student">
        select * from student where id=#{id}
    </select>
    <select id="deleteById" resultType="org.example.hw4.pojo.Student">
        delete from student where id=#{id}
    </select>
</mapper>